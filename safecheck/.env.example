# Copier en .env.local (ignoré par git). Toutes ces valeurs sont publiques côté client :
# la sécurité repose sur les politiques RLS PostgreSQL, jamais sur le secret de ces clés.

# Source de données : "mock" (développement hors-ligne, tests) ou "supabase"
EXPO_PUBLIC_DATA_SOURCE=mock

EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Environnement applicatif : development | staging | production
EXPO_PUBLIC_APP_ENV=development

# Pays par défaut pour la normalisation des numéros de téléphone (ISO 3166-1 alpha-2)
EXPO_PUBLIC_DEFAULT_REGION=FR
