generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String    @id @default(cuid())
  clerkId          String    @unique
  email            String    @unique
  name             String?
  imageUrl         String?
  stripeCustomerId String?   @unique
  plan             Plan      @default(FREE)
  generationsUsed  Int       @default(0)
  generationsReset DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  subscriptions Subscription[]
  generations   Generation[]
  projects      Project[]
  favorites     Favorite[]
  clients       Client[]
}

enum Plan {
  FREE
  PRO
  AGENCY
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String
  stripeSubscriptionId String             @unique
  stripePriceId        String
  status               SubscriptionStatus
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
  INCOMPLETE
}

model Generation {
  id        String      @id @default(cuid())
  userId    String
  clientId  String?
  type      ContentType
  niche     String
  audience  String
  objective String
  platform  Platform
  content   Json
  createdAt DateTime    @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  client    Client?    @relation(fields: [clientId], references: [id])
  favorites Favorite[]
}

enum ContentType {
  VIDEO_IDEAS
  VIRAL_HOOKS
  FULL_SCRIPT
  CTA
  HASHTAGS
  YOUTUBE_TITLE
  DESCRIPTION
  EDITORIAL_CALENDAR
}

enum Platform {
  TIKTOK
  INSTAGRAM
  YOUTUBE
  FACEBOOK
}

model Project {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  niche       String
  platform    Platform
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Favorite {
  id           String   @id @default(cuid())
  userId       String
  generationId String
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  generation Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)

  @@unique([userId, generationId])
}

model Client {
  id        String   @id @default(cuid())
  userId    String
  name      String
  niche     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  generations Generation[]
}

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  content     String
  category    String
  tags        String[]
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
