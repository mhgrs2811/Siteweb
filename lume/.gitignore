# Dependencies
node_modules/

# Expo (expo-env.d.ts is committed on purpose so CI can typecheck without the Expo CLI)
.expo/
dist/
web-build/

# Native folders are generated by EAS / prebuild (Continuous Native Generation)
ios/
android/

# Metro / caches
.metro-health-check*
*.tsbuildinfo

# Environment (never commit secrets)
.env
.env.*
!.env.example

# Debug & logs
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# macOS
.DS_Store
*.pem

# Tests
coverage/

# Local Playwright output
.preview/

# Skia web runtime copied by `npx setup-skia-web public`
public/canvaskit.wasm

# EAS
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
