# ------------------------------------------------------------------
# Lumé · environment variables
#
# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
# Variables prefixed with EXPO_PUBLIC_ are inlined in the JavaScript bundle:
# they are PUBLIC. Never put a secret key behind an EXPO_PUBLIC_ prefix.
# Server-side secrets (AI provider key, RevenueCat webhook secret, …) live in
# `supabase/functions/.env` from Phase 2 onward and never reach the app.
# ------------------------------------------------------------------

# Build variant read by app.config.ts: development | preview | production.
# Controls the app name and the bundle identifier suffix.
APP_VARIANT=development

# EAS project, filled by `eas init` (run from your machine, see README).
# Alternatively paste the values directly into app.config.ts.
EAS_PROJECT_ID=
EXPO_OWNER=

# Supabase (Phase 1). EU-hosted project. The anon / publishable key is public by design;
# security comes from Row Level Security.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# PostHog (Phase 1). EU ingestion host.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# RevenueCat public SDK keys (Phase 3). One per platform.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Show developer-only screens (such as /dev/design-system) in non-development
# builds. Leave empty in production.
EXPO_PUBLIC_ENABLE_DEV_SCREENS=
