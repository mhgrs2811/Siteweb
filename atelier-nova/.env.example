# URL publique du site (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.ateliernova.be

# Envoi du formulaire de contact via Resend (https://resend.com)
# Sans clé, le formulaire répond « service d'envoi non configuré » et propose l'e-mail direct.
RESEND_API_KEY=
# Adresse expéditrice vérifiée chez Resend (domaine validé)
CONTACT_FROM_EMAIL="Atelier Nova <brief@ateliernova.be>"
# Boîte qui reçoit les briefs
CONTACT_TO_EMAIL=hello@ateliernova.be
