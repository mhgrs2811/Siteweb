---
import Base from '@/layouts/Base.astro';
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';
import HeroScene from '@/components/HeroScene.astro';
import Placeholder from '@/components/Placeholder.astro';
import Hours from '@/components/Hours.astro';
import { restaurant } from '@/data/restaurant';
import { content } from '@/data/content';
import { sortedCategories } from '@/data/menu';
import { featuredGallery } from '@/data/gallery';
import { addressLine, compactHours, directionsUrl, listingUrl, telHref } from '@/lib/hours';

const hours = compactHours();
const categories = sortedCategories();
const hasProposed = categories.some((c) => c.status === 'proposed');
const gallery = featuredGallery();
const g = restaurant.googleListing;
const orderCta = restaurant.cta.order;
const deliveryCta = restaurant.cta.delivery;
---

<Base
  title={restaurant.seo.defaultTitle}
  description={restaurant.seo.defaultDescription}
  rawTitle
  headerTheme="dark"
>
  <!-- ========== 1. HERO ========== -->
  <section class="hero on-dark grain" data-hero aria-labelledby="hero-title">
    <div class="container hero__grid">
      <div class="hero__text">
        <p class="eyebrow hero__eyebrow">{content.hero.eyebrow}</p>
        <h1 id="hero-title" class="hero__title">
          <span class="hero__title-a">Snack</span>
          <span class="hero__title-b">Gorbuz</span>
        </h1>
        <p class="hero__subtitle">{content.hero.subtitle}</p>
        <div class="hero__cta">
          <Button href="/menu/" variant="inverse" size="lg" icon="arrow-right">
            {content.hero.primaryCta}
          </Button>
          <Button href="/contact/" variant="outline" size="lg">
            {content.hero.secondaryCta}
          </Button>
          {
            orderCta.enabled && orderCta.url && (
              <Button href={orderCta.url} variant="outline" size="lg" external>
                {orderCta.label}
              </Button>
            )
          }
        </div>
        <ul class="hero__facts">
          <li>
            <Icon name="map-pin" size={16} />
            <a href={directionsUrl()} target="_blank" rel="noopener noreferrer">{addressLine()}</a>
          </li>
          <li>
            <Icon name="clock" size={16} />
            <span>{hours.map((h) => `${h.days} ${h.value}`).join(' · ')}</span>
          </li>
          <li>
            <Icon name="phone" size={16} />
            <a href={telHref()}>{restaurant.phone.display}</a>
          </li>
        </ul>
      </div>
      <div class="hero__scene">
        <HeroScene />
      </div>
    </div>
    <div class="hero__counter" aria-hidden="true"></div>
  </section>

  <!-- ========== 2. REPÈRES PRATIQUES ========== -->
  <section class="band" aria-label="Repères pratiques">
    <div class="container">
      <ul class="band__list">
        <li class="band__item" data-reveal>
          <span class="band__label">Adresse</span>
          <a class="band__value" href={directionsUrl()} target="_blank" rel="noopener noreferrer">
            {addressLine()}
          </a>
        </li>
        <li class="band__item" data-reveal style="--reveal-delay: 60ms">
          <span class="band__label">Horaires</span>
          <span class="band__value">
            {
              hours.map((h, i) => (
                <>
                  <span class="band__hours-day">{h.days}</span>{' '}
                  <span class="tabular">{h.value}</span>
                  {i < hours.length - 1 && <span class="band__sep" aria-hidden="true"> · </span>}
                </>
              ))
            }
          </span>
        </li>
        {
          g.mentions.takeaway && (
            <li class="band__item" data-reveal style="--reveal-delay: 120ms">
              <span class="band__label">{content.reassurance.takeaway.label}</span>
              <span class="band__value band__value--sm">{content.reassurance.takeaway.text}</span>
            </li>
          )
        }
        <li class="band__item" data-reveal style="--reveal-delay: 180ms">
          <span class="band__label">Avis Google</span>
          <a class="band__value band__value--rating" href={listingUrl()} target="_blank" rel="noopener noreferrer">
            <span class="band__rating">
              <Icon name="star" size={16} />
              <span class="tabular">{g.ratingDisplay}/5</span>
            </span>
            <span class="band__value--sm">
              {g.reviewCount} avis · fiche consultée en {g.capturedOn}
            </span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <!-- ========== 3. LA CARTE ========== -->
  <section class="section surface-2" aria-labelledby="menu-title">
    <div class="container grid-12 menu-preview">
      <div class="menu-preview__intro" data-reveal>
        <p class="eyebrow">{content.menuPreview.eyebrow}</p>
        <h2 id="menu-title">{content.menuPreview.title}</h2>
        <p class="lead">{content.menuPreview.text}</p>
        <div class="menu-preview__cta">
          <Button href="/menu/" variant="primary" icon="arrow-right">{content.menuPreview.cta}</Button>
        </div>
      </div>
      <div class="menu-preview__list" data-reveal style="--reveal-delay: 100ms">
        {hasProposed && <p class="notice">{content.menuPreview.structureNote}</p>}
        <ol class="cat-list">
          {
            categories.map((cat, i) => (
              <li class="cat-list__item">
                <a href={`/menu/#${cat.id}`} class="cat-list__link">
                  <span class="cat-list__num tabular" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                  <span class="cat-list__name">{cat.name}</span>
                  <span class="cat-list__state">
                    {cat.status === 'proposed' ? 'à confirmer' : 'bientôt en ligne'}
                  </span>
                  <Icon name="arrow-up-right" size={18} class="cat-list__icon" />
                </a>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- ========== 4. L'UNIVERS ========== -->
  <section class="section" aria-labelledby="univers-title">
    <div class="container grid-12 universe">
      <div class="universe__media" data-reveal>
        <Placeholder subject="Le comptoir" tone="espresso" ratio="4 / 5" variant={1} />
      </div>
      <div class="universe__text" data-reveal style="--reveal-delay: 100ms">
        <p class="eyebrow">{content.universe.eyebrow}</p>
        <h2 id="univers-title">{content.universe.title}</h2>
        {content.universe.paragraphs.map((p) => <p class="universe__p">{p}</p>)}
        <dl class="facts">
          {
            content.universe.facts.map((f) => (
              <div class="facts__row">
                <dt>{f.label}</dt>
                <dd>{f.value}</dd>
              </div>
            ))
          }
        </dl>
        <Button href="/univers/" variant="link" icon="arrow-right">{content.universe.cta}</Button>
      </div>
    </div>
  </section>

  <!-- ========== 5. GALERIE ========== -->
  <section class="section on-dark" aria-labelledby="galerie-title">
    <div class="container">
      <div class="section-head gallery-head" data-reveal>
        <div>
          <p class="eyebrow">{content.gallery.eyebrow}</p>
          <h2 id="galerie-title">{content.gallery.title}</h2>
        </div>
        <p class="muted gallery-head__text">{content.gallery.text}</p>
      </div>
      <div class="gallery-grid">
        {
          gallery.map((entry, i) => (
            <div class:list={['gallery-grid__cell', `gallery-grid__cell--${i + 1}`]} data-reveal style={`--reveal-delay:${i * 60}ms`}>
              <Placeholder
                subject={entry.subject}
                tone={entry.tone}
                ratio={entry.ratio}
                src={entry.src}
                alt={entry.alt}
                width={entry.width}
                height={entry.height}
                variant={i}
              />
            </div>
          ))
        }
      </div>
      <div class="gallery-cta" data-reveal>
        <Button href="/galerie/" variant="inverse" icon="arrow-right">{content.gallery.cta}</Button>
      </div>
    </div>
  </section>

  <!-- ========== 6. VISITER ========== -->
  <section class="section visit" aria-labelledby="visit-title">
    <div class="container grid-12">
      <div class="visit__text" data-reveal>
        <p class="eyebrow">{content.visit.eyebrow}</p>
        <h2 id="visit-title">{content.visit.title}</h2>
        <p class="lead">{content.visit.text}</p>
        <address class="visit__address">
          <span class="visit__street">{restaurant.address.street}</span>
          <span class="visit__city">
            {restaurant.address.postalCode} {restaurant.address.city}, {restaurant.address.country}
          </span>
          <a class="visit__phone" href={telHref()}>{restaurant.phone.display}</a>
        </address>
        <div class="visit__cta">
          <Button href={directionsUrl()} variant="primary" icon="arrow-up-right" external>
            {content.visit.directionsCta}
          </Button>
          <Button href={telHref()} variant="outline" icon="phone" iconPosition="start">
            {content.visit.callCta}
          </Button>
          {
            deliveryCta.enabled && deliveryCta.url && (
              <Button href={deliveryCta.url} variant="outline" external>
                {deliveryCta.label}
              </Button>
            )
          }
        </div>
      </div>
      <div class="visit__hours" data-reveal style="--reveal-delay: 100ms">
        <h3 class="visit__hours-title">Horaires d’ouverture</h3>
        <Hours />
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- HERO ---------- */
  .hero {
    position: relative;
    margin-top: calc(-1 * var(--header-h));
    padding-top: calc(var(--header-h) + var(--sp-6));
    padding-bottom: var(--sp-8);
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background:
      radial-gradient(90% 60% at 72% 30%, rgb(184 135 79 / 0.22), transparent 60%),
      radial-gradient(60% 50% at 20% 100%, rgb(138 47 42 / 0.25), transparent 60%),
      var(--c-espresso);
  }

  .hero__counter {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 28%;
    background: linear-gradient(to bottom, transparent, rgb(0 0 0 / 0.28));
    pointer-events: none;
    z-index: 0;
  }

  .hero__grid {
    display: grid;
    gap: var(--sp-6);
    width: min(100% - 2 * var(--gutter), var(--container));
  }

  .hero__scene {
    order: -1;
    height: clamp(14rem, 42svh, 22rem);
  }

  .hero__text {
    display: grid;
    gap: var(--sp-5);
    justify-items: start;
  }

  .hero__eyebrow {
    color: var(--c-copper);
  }

  .hero__title {
    display: grid;
    line-height: 0.92;
    font-size: var(--fs-hero);
    letter-spacing: -0.035em;
  }

  .hero__title-a {
    font-size: 0.42em;
    font-weight: 400;
    font-style: italic;
    letter-spacing: -0.01em;
    color: var(--c-ink-on-dark-soft);
    font-variation-settings: 'opsz' 72;
    margin-bottom: 0.08em;
  }

  .hero__title-b {
    font-weight: 500;
  }

  .hero__subtitle {
    font-size: var(--fs-md);
    line-height: 1.5;
    max-width: 34ch;
    color: var(--c-ink-on-dark-soft);
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
  }

  .hero__facts {
    display: grid;
    gap: var(--sp-2);
    margin-top: var(--sp-2);
    padding-top: var(--sp-4);
    border-top: 1px solid var(--c-espresso-line);
    font-size: var(--fs-sm);
    color: var(--c-ink-on-dark-soft);
    width: 100%;
    max-width: 40rem;
  }

  .hero__facts li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
  }

  .hero__facts :global(.icon) {
    margin-top: 0.3em;
    color: var(--c-copper);
  }

  .hero__facts a {
    display: inline-block;
    padding: 0.4rem 0;
    margin: -0.4rem 0;
    text-decoration: none;
    color: var(--c-ink-on-dark);
  }

  .hero__facts a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media (min-width: 64em) {
    .hero {
      padding-top: var(--header-h);
      padding-bottom: 0;
      min-height: calc(100svh);
    }

    .hero__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: center;
      min-height: calc(100svh - var(--header-h));
    }

    .hero__text {
      grid-column: 1 / 7;
      padding-block: var(--sp-8);
    }

    .hero__scene {
      order: 0;
      grid-column: 7 / 13;
      height: min(72svh, 44rem);
      align-self: center;
    }
  }

  /* ---------- BANDEAU ---------- */
  .band {
    border-bottom: 1px solid var(--c-line);
  }

  .band__list {
    display: grid;
    grid-template-columns: 1fr;
  }

  .band__item {
    display: grid;
    gap: 0.3rem;
    padding: var(--sp-5) 0;
    border-bottom: 1px solid var(--c-line);
  }

  .band__item:last-child {
    border-bottom: 0;
  }

  .band__label {
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-ink-soft);
  }

  .band__value {
    display: block;
    font-weight: 600;
  }

  a.band__value {
    padding: 0.35rem 0;
    margin: -0.35rem 0;
    font-size: var(--fs-sm);
    text-decoration: none;
  }

  .band__value--sm {
    display: block;
    font-weight: 500;
    color: var(--c-ink-soft);
  }

  .band__value--rating {
    display: grid;
    gap: 0.2rem;
  }

  .band__hours-day {
    color: var(--c-ink-soft);
    font-weight: 500;
  }

  .band__sep {
    color: var(--c-copper-ink);
  }

  .band__rating {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--c-accent);
  }

  @media (min-width: 48em) {
    .band__list {
      grid-template-columns: repeat(2, 1fr);
      column-gap: var(--gutter);
    }
  }

  @media (min-width: 64em) {
    .band__list {
      grid-template-columns: 1.3fr 1.6fr 1fr 1fr;
    }

    .band__item {
      padding: var(--sp-6) var(--sp-5) var(--sp-6) 0;
      border-bottom: 0;
      border-right: 1px solid var(--c-line);
    }

    .band__item + .band__item {
      padding-left: var(--sp-5);
    }

    .band__item:last-child {
      border-right: 0;
    }
  }

  /* ---------- CARTE (aperçu) ---------- */
  .menu-preview__intro {
    grid-column: 1 / -1;
    display: grid;
    gap: var(--sp-4);
    align-content: start;
    justify-items: start;
  }

  .menu-preview__cta {
    margin-top: var(--sp-2);
  }

  .menu-preview__list {
    grid-column: 1 / -1;
    display: grid;
    gap: var(--sp-4);
    align-content: start;
    justify-items: start;
  }

  .cat-list {
    width: 100%;
    border-top: 1px solid var(--c-line);
  }

  .cat-list__link {
    display: grid;
    grid-template-columns: 2.5rem 1fr auto 1.5rem;
    align-items: center;
    gap: var(--sp-3);
    padding: var(--sp-4) 0;
    border-bottom: 1px solid var(--c-line);
    text-decoration: none;
    transition: padding-left var(--dur-base) var(--ease-out);
  }

  .cat-list__link:hover {
    padding-left: var(--sp-2);
    color: inherit;
  }

  .cat-list__num {
    font-size: var(--fs-xs);
    font-weight: 700;
    color: var(--c-copper-ink);
    letter-spacing: 0.06em;
  }

  .cat-list__name {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .cat-list__state {
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--c-ink-soft);
    letter-spacing: 0.04em;
  }

  .cat-list__icon {
    color: var(--c-accent);
    opacity: 0;
    transform: translate(-4px, 4px);
    transition:
      opacity var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }

  .cat-list__link:hover .cat-list__icon {
    opacity: 1;
    transform: none;
  }

  @media (min-width: 64em) {
    .menu-preview__intro {
      grid-column: 1 / 6;
      position: sticky;
      top: calc(var(--header-h) + var(--sp-6));
    }

    .menu-preview__list {
      grid-column: 7 / 13;
    }
  }

  /* ---------- UNIVERS ---------- */
  .universe__media {
    grid-column: 1 / -1;
  }

  .universe__text {
    grid-column: 1 / -1;
    display: grid;
    gap: var(--sp-4);
    justify-items: start;
    align-content: center;
  }

  .universe__p {
    color: var(--c-ink-soft);
  }

  .facts {
    width: 100%;
    max-width: 30rem;
    margin-block: var(--sp-3);
    border-top: 1px solid var(--c-line);
  }

  .facts__row {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: var(--sp-3);
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--c-line);
    font-size: var(--fs-sm);
  }

  .facts__row dt {
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: var(--fs-xs);
    color: var(--c-ink-soft);
    padding-top: 0.15em;
  }

  .facts__row dd {
    font-weight: 500;
  }

  @media (min-width: 64em) {
    .universe__media {
      grid-column: 1 / 6;
    }

    .universe__text {
      grid-column: 7 / 13;
    }
  }

  /* ---------- GALERIE ---------- */
  .gallery-head {
    grid-template-columns: 1fr;
    align-items: end;
  }

  .gallery-head__text {
    max-width: 44ch;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--sp-4);
  }

  .gallery-grid__cell--1 {
    grid-column: 1 / -1;
  }

  .gallery-grid__cell--5 {
    grid-column: 1 / -1;
  }

  .gallery-cta {
    margin-top: var(--sp-7);
  }

  @media (min-width: 48em) {
    .gallery-head {
      grid-template-columns: 1fr 1fr;
    }

    .gallery-grid {
      grid-template-columns: repeat(12, 1fr);
      gap: var(--sp-5);
    }

    .gallery-grid__cell--1 {
      grid-column: 1 / 6;
      grid-row: 1 / 3;
    }
    .gallery-grid__cell--2 {
      grid-column: 6 / 13;
    }
    .gallery-grid__cell--3 {
      grid-column: 6 / 9;
    }
    .gallery-grid__cell--4 {
      grid-column: 9 / 13;
    }
    .gallery-grid__cell--5 {
      grid-column: 1 / 13;
    }

    .gallery-grid__cell--5 :global(.ph) {
      --ph-ratio: 21 / 9;
    }
  }

  /* ---------- VISITE ---------- */
  .visit {
    background: var(--c-paper);
  }

  .visit__text {
    grid-column: 1 / -1;
    display: grid;
    gap: var(--sp-4);
    justify-items: start;
    align-content: start;
  }

  .visit__address {
    display: grid;
    gap: 0.2rem;
    font-style: normal;
    margin-top: var(--sp-2);
  }

  .visit__street {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1rem + 3.2vw, 2.75rem);
    overflow-wrap: anywhere;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .visit__city {
    font-size: var(--fs-md);
    color: var(--c-ink-soft);
  }

  .visit__phone {
    display: inline-block;
    margin-top: var(--sp-2);
    font-size: var(--fs-md);
    font-weight: 700;
    text-decoration: none;
  }

  .visit__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    margin-top: var(--sp-3);
  }

  .visit__hours {
    grid-column: 1 / -1;
    display: grid;
    gap: var(--sp-4);
    align-content: start;
    padding: var(--sp-6);
    background: var(--c-cream);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-md);
  }

  .visit__hours-title {
    font-size: var(--fs-md);
  }

  @media (min-width: 64em) {
    .visit__text {
      grid-column: 1 / 7;
    }

    .visit__hours {
      grid-column: 8 / 13;
    }
  }
</style>
