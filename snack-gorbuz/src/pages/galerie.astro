---
import Base from '@/layouts/Base.astro';
import Placeholder from '@/components/Placeholder.astro';
import { restaurant } from '@/data/restaurant';
import { content } from '@/data/content';
import { gallery } from '@/data/gallery';

const page = content.pages.gallery;
const hasRealPhotos = gallery.some((g) => g.src);
---

<Base
  title="Galerie"
  description={`Photos de ${restaurant.name} à ${restaurant.address.city} : façade, comptoir, préparation, produits et équipe.`}
>
  <header class="page-head">
    <div class="container page-head__inner">
      <p class="eyebrow">{content.gallery.eyebrow}</p>
      <h1>{page.title}</h1>
      <p class="lead">{page.intro}</p>
      {!hasRealPhotos && <p class="notice">Emplacements temporaires — photographies officielles à venir</p>}
    </div>
  </header>

  <section class="section-tight" aria-label="Photographies">
    <div class="container">
      <ul class="mosaic">
        {
          gallery.map((entry, i) => (
            <li class:list={['mosaic__cell', `mosaic__cell--${(i % 8) + 1}`]} data-reveal style={`--reveal-delay:${(i % 4) * 60}ms`}>
              <Placeholder
                subject={entry.subject}
                tone={entry.tone}
                ratio={entry.ratio}
                src={entry.src}
                alt={entry.alt}
                width={entry.width}
                height={entry.height}
                caption={entry.caption}
                variant={i}
              />
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .page-head {
    padding-block: var(--sp-8) var(--sp-7);
  }

  .page-head__inner {
    display: grid;
    gap: var(--sp-4);
    justify-items: start;
  }

  .section-tight {
    padding-block: var(--sp-5) var(--sp-9);
  }

  .mosaic {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--sp-4);
  }

  .mosaic__cell--1,
  .mosaic__cell--5 {
    grid-column: 1 / -1;
  }

  @media (min-width: 48em) {
    .mosaic {
      grid-template-columns: repeat(12, 1fr);
      gap: var(--sp-5);
      align-items: start;
    }

    .mosaic__cell--1 {
      grid-column: 1 / 6;
    }
    .mosaic__cell--2 {
      grid-column: 6 / 13;
    }
    .mosaic__cell--3 {
      grid-column: 1 / 5;
    }
    .mosaic__cell--4 {
      grid-column: 5 / 9;
    }
    .mosaic__cell--5 {
      grid-column: 9 / 13;
    }
    .mosaic__cell--6 {
      grid-column: 1 / 8;
    }
    .mosaic__cell--7 {
      grid-column: 8 / 13;
    }
    .mosaic__cell--8 {
      grid-column: 3 / 8;
    }
  }
</style>
