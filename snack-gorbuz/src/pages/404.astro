---
import Base from '@/layouts/Base.astro';
import Button from '@/components/Button.astro';
import { restaurant } from '@/data/restaurant';
---

<Base title="Page introuvable" description={`Cette page n’existe pas sur le site de ${restaurant.name}.`}>
  <div class="container nf">
    <p class="eyebrow">Erreur 404</p>
    <h1>Cette page n’est pas à la carte.</h1>
    <p class="lead">L’adresse demandée n’existe pas ou a été déplacée.</p>
    <div class="nf__cta">
      <Button href="/" variant="primary" icon="arrow-right">Retour à l’accueil</Button>
      <Button href="/menu/" variant="outline">Voir la carte</Button>
    </div>
  </div>
</Base>

<style>
  .nf {
    display: grid;
    gap: var(--sp-4);
    justify-items: start;
    padding-block: var(--sp-10);
    min-height: 60vh;
    align-content: center;
  }

  .nf__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    margin-top: var(--sp-3);
  }
</style>
