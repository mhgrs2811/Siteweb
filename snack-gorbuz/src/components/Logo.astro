---
/**
 * Logo typographique temporaire : monogramme « G » + nom en Fraunces.
 * À remplacer par le logo officiel dès réception (ce composant est le seul endroit à modifier).
 */
import { restaurant } from '@/data/restaurant';

interface Props {
  class?: string;
  /** Taille du monogramme en px. */
  size?: number;
}
const { class: className, size = 36 } = Astro.props;
---

<a href="/" class:list={['logo', className]} aria-label={`${restaurant.name} — accueil`}>
  <svg
    class="logo__mark"
    width={size}
    height={size}
    viewBox="0 0 48 48"
    aria-hidden="true"
    focusable="false"
  >
    <circle cx="24" cy="24" r="23" fill="var(--logo-mark-bg, var(--c-accent))"></circle>
    <text
      x="24"
      y="33"
      text-anchor="middle"
      font-family="Fraunces Variable, Fraunces, Georgia, serif"
      font-size="28"
      font-weight="600"
      font-style="italic"
      fill="var(--logo-mark-fg, var(--c-cream))">G</text
    >
  </svg>
  <span class="logo__word">
    <span class="logo__word-a">Snack</span>
    <span class="logo__word-b">Gorbuz</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: inherit;
    line-height: 1;
  }

  .logo:hover {
    color: inherit;
  }

  .logo__mark {
    flex: none;
  }

  .logo__word {
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
    font-variation-settings:
      'opsz' 24,
      'SOFT' 60;
    letter-spacing: -0.01em;
  }

  .logo__word-a {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-family: var(--font-body);
    opacity: 0.75;
    margin-bottom: 0.15rem;
  }

  .logo__word-b {
    font-size: 1.35rem;
    font-weight: 600;
  }
</style>
