---
/**
 * Conteneur de la scène du hero : canvas (pseudo-3D procédurale) + repli CSS
 * affiché sans JavaScript, avant initialisation, ou si le canvas est indisponible.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={['scene', className]} data-hero-scene>
  <canvas class="scene__canvas" aria-hidden="true"></canvas>
  <div class="scene__fallback" aria-hidden="true">
    <span class="scene__disc scene__disc--1"></span>
    <span class="scene__disc scene__disc--2"></span>
    <span class="scene__disc scene__disc--3"></span>
    <span class="scene__disc scene__disc--4"></span>
    <span class="scene__disc scene__disc--5"></span>
    <span class="scene__disc scene__disc--6"></span>
  </div>
</div>

<script>
  import '@/scripts/hero-scene';
</script>

<style>
  .scene {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 16rem;
    overflow: visible;
  }

  .scene__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity var(--dur-slow) var(--ease-out);
  }

  .scene.is-ready .scene__canvas {
    opacity: 1;
  }

  /* --- Repli CSS : pile de disques statique --- */
  .scene__fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    pointer-events: none;
    transition: opacity var(--dur-slow) var(--ease-out);
  }

  .scene.is-ready .scene__fallback {
    opacity: 0;
  }

  .scene__disc {
    --d: 60%;
    --y: 0px;
    position: absolute;
    left: 50%;
    top: 50%;
    width: var(--d);
    aspect-ratio: 2.4 / 1;
    transform: translate(-50%, calc(-50% + var(--y)));
    border-radius: 50%;
    box-shadow:
      0 10px 0 0 var(--shade, #1f1510),
      0 30px 40px -10px rgb(0 0 0 / 0.45);
  }

  .scene__disc--1 {
    --d: 64%;
    --y: 4rem;
    background: #e6dac6;
    --shade: #b9a98f;
  }
  .scene__disc--2 {
    --d: 50%;
    --y: 2.2rem;
    background: #3b2c23;
  }
  .scene__disc--3 {
    --d: 54%;
    --y: 0.4rem;
    background: #8a2f2a;
    --shade: #55191a;
  }
  .scene__disc--4 {
    --d: 46%;
    --y: -1.4rem;
    background: #f3ecdf;
    --shade: #c4b59c;
  }
  .scene__disc--5 {
    --d: 40%;
    --y: -3rem;
    background: #b8874f;
    --shade: #7f5a30;
  }
  .scene__disc--6 {
    --d: 28%;
    --y: -4.6rem;
    background: #3b2c23;
  }
</style>
